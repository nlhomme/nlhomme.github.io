<!DOCTYPE html>
<html lang="{{ site.lang }}" data-mode="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="theme-color" content="#1b1b1e">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png">
  <link rel="shortcut icon" href="/assets/img/favicons/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png">
  <link rel="mask-icon" href="/assets/img/favicons/safari-pinned-tab.svg" color="#1b1b1e">

  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="fr_FR">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@700;900&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;

      --main-bg: rgb(27 27 30);
      --mask-bg: rgb(68 69 70);
      --main-border-color: rgb(44 45 45);

      --text-color: rgb(175 176 177);
      --text-muted-color: #868686;
      --text-muted-highlight-color: #aeaeae;
      --heading-color: #cccccc;
      --label-color: #a7a7a7;
      --blockquote-border-color: rgb(66 66 66);
      --blockquote-text-color: #868686;
      --link-color: rgb(138 180 248);
      --link-underline-color: rgb(82 108 150);

      --site-title-color: #717070;
      --site-subtitle-color: #868686;
      --sidebar-bg: #1e1e1e;
      --sidebar-border-color: #292929;
      --sidebar-muted-color: #868686;
      --sidebar-active-color: rgb(255 255 255 / 95%);
      --sidebar-hover-bg: #262626;
      --sidebar-btn-bg: #232328;
      --sidebar-btn-color: #787878;
      --avatar-border-color: rgb(206 206 206 / 90%);

      --card-bg: #1e1e1e;
      --card-header-bg: #292929;
      --card-shadow: rgb(21 21 21 / 72%) 0 6px 18px 0, rgb(137 135 135 / 24%) 0 0 0 1px;
      --card-hover-bg: #464d51;

      --tag-border: rgb(59 79 88);
      --tag-hover: rgb(43 56 62);
      --tag-shadow: rgb(32 33 33);

      --inline-code-bg: rgb(255 255 255 / 5%);
      --highlight-bg-color: #151515;
      --code-color: #b0b0b0;
      --language-border-color: #2d2d2d;

      --sidebar-width: 260px;
      --sidebar-width-large: 300px;
      --topbar-height: 3rem;
      --radius-sm: 6px;
      --radius-lg: 10px;

      --font-family-base: 'Source Sans 3', 'Source Sans Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-family-heading: Lato, 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-family-base);
      background: var(--main-bg);
      color: var(--text-color);
      font-size: 1rem;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-family-heading);
      color: var(--heading-color);
      font-weight: 700;
      line-height: 1.25;
    }

    a {
      color: var(--link-color);
      text-decoration: none;
      text-decoration-color: var(--link-underline-color);
    }
    a:hover { text-decoration: underline; }

    /* ========== Sidebar ========== */

    #sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-width);
      background: var(--sidebar-bg);
      border-right: 1px solid var(--sidebar-border-color);
      overflow-y: auto;
      scrollbar-width: none;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      z-index: 99;
      transform: translateX(-100%);
      transition: transform 0.3s ease-in-out;
    }
    #sidebar::-webkit-scrollbar { display: none; }

    [sidebar-display] #sidebar { transform: translateX(0); }

    @media (min-width: 850px) {
      #sidebar { transform: translateX(0); }
    }

    @media (min-width: 1650px) {
      #sidebar { width: var(--sidebar-width-large); }
    }

    .profile-wrapper {
      margin: 2.5rem 0;
      padding: 0 1.25rem 0 2.5rem;
      width: 100%;
    }
    @media (min-width: 850px) {
      .profile-wrapper { margin-top: 3rem; }
    }

    #avatar {
      display: block;
      width: 7rem;
      height: 7rem;
      border-radius: 50%;
      overflow: hidden;
      box-shadow: var(--avatar-border-color) 0 0 0 2px;
    }
    #avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }
    #avatar:hover img { transform: scale(1.2); }

    .site-title {
      font-family: var(--font-family-heading);
      font-weight: 900;
      font-size: 1.75rem;
      line-height: 1.2;
      letter-spacing: 0.25px;
      margin-top: 1.25rem;
      margin-bottom: 0.5rem;
      width: fit-content;
    }
    .site-title a { color: var(--site-title-color); }
    .site-title a:hover { color: var(--sidebar-active-color); text-decoration: none; }

    .site-subtitle {
      font-size: 95%;
      color: var(--site-subtitle-color);
      margin-top: 0.25rem;
      word-spacing: 1px;
      user-select: none;
    }

    .sidebar-nav {
      width: 100%;
      margin-bottom: 2rem;
      list-style: none;
    }

    .sidebar-nav li {
      position: relative;
      width: 100%;
    }

    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: 0.6rem 1.5rem 0.6rem 2.5rem;
      font-family: var(--font-family-heading);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.2px;
      color: var(--sidebar-muted-color);
      text-transform: uppercase;
      border-left: 3px solid transparent;
      transition: background 0.3s, color 0.35s, border-left-color 0.35s;
    }
    .sidebar-nav a:hover {
      background: var(--sidebar-hover-bg);
      color: var(--sidebar-active-color);
      text-decoration: none;
    }
    .sidebar-nav li.active a {
      background: linear-gradient(90deg, var(--sidebar-hover-bg) 0%, rgb(38 38 38 / 0) 100%);
      color: var(--sidebar-active-color);
      border-left-color: var(--link-color);
    }
    .sidebar-nav svg.icon { width: 1rem; height: 1rem; flex-shrink: 0; }

    .sidebar-bottom {
      width: 100%;
      margin-top: auto;
      padding: 1.25rem 1.5rem 1.25rem 2.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }
    .sidebar-bottom a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--sidebar-btn-bg);
      color: var(--sidebar-btn-color);
      transition: color 0.25s, background 0.25s;
    }
    .sidebar-bottom a:hover {
      color: var(--sidebar-active-color);
      background: var(--sidebar-hover-bg);
      text-decoration: none;
    }
    .sidebar-bottom svg.icon { width: 1rem; height: 1rem; }
    .sidebar-bottom .copyright {
      width: 100%;
      font-size: 0.72rem;
      color: var(--sidebar-muted-color);
      margin-top: 0.5rem;
      line-height: 1.4;
    }

    /* ========== Topbar (small screens only) ========== */

    #topbar-wrapper {
      position: sticky;
      top: 0;
      height: var(--topbar-height);
      background: rgb(27 27 30 / 64%);
      backdrop-filter: saturate(200%) blur(20px);
      -webkit-backdrop-filter: saturate(200%) blur(20px);
      border-bottom: 1px solid var(--main-border-color);
      z-index: 50;
      display: flex;
      align-items: center;
      padding: 0 1rem;
    }
    @media (min-width: 850px) { #topbar-wrapper { display: none; } }

    #sidebar-trigger {
      background: none;
      border: none;
      color: var(--text-color);
      font-size: 1.2rem;
      padding: 0.3rem 0.6rem;
      cursor: pointer;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
    }
    #sidebar-trigger svg { width: 1.25rem; height: 1.25rem; }
    #topbar-title {
      font-family: var(--font-family-heading);
      font-weight: 900;
      font-size: 1.1rem;
      color: var(--heading-color);
      margin-left: 0.8rem;
    }

    #mask {
      position: fixed;
      inset: 0;
      background: var(--mask-bg);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      z-index: 90;
    }
    [sidebar-display] #mask {
      opacity: 0.5;
      pointer-events: auto;
    }
    @media (min-width: 850px) { #mask { display: none; } }

    /* ========== Main layout ========== */

    #main-wrapper {
      margin-left: 0;
      min-height: calc(100vh - var(--topbar-height));
    }
    @media (min-width: 850px) {
      #main-wrapper { margin-left: var(--sidebar-width); }
    }
    @media (min-width: 1650px) {
      #main-wrapper { margin-left: var(--sidebar-width-large); }
    }

    .page {
      display: flex;
      gap: 2.5rem;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1rem;
      align-items: flex-start;
      justify-content: center;
    }
    @media (min-width: 850px) {
      .page { padding: 0 2rem; }
    }

    main {
      flex: 1 1 auto;
      min-width: 0;
      max-width: 920px;
      padding: 2rem 0 3rem;
    }
    @media (min-width: 850px) {
      main { padding: 3rem 0 4rem; }
    }

    /* ========== Right panel ========== */

    #panel-wrapper {
      display: none;
      flex: 0 0 240px;
      padding: 3rem 0 4rem;
      position: sticky;
      top: 2rem;
      color: var(--text-muted-color);
    }
    @media (min-width: 1200px) {
      #panel-wrapper { display: block; }
    }

    .panel-box { margin-bottom: 2.25rem; }

    .panel-heading {
      font-family: var(--font-family-heading);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--heading-color);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }
    .panel-heading svg.icon {
      width: 0.95rem;
      height: 0.95rem;
      color: var(--link-color);
    }

    .tag-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
    }
    .tag-pill {
      display: inline-flex;
      align-items: baseline;
      gap: 0.3rem;
      padding: 0.25rem 0.7rem;
      border: 1px solid var(--tag-border);
      border-radius: 999px;
      color: var(--text-muted-color);
      font-size: 0.78rem;
      line-height: 1.5;
      transition: background 0.25s, color 0.25s;
      box-shadow: 0 0 2px var(--tag-shadow);
    }
    a.tag-pill:hover {
      background: var(--tag-hover);
      color: var(--sidebar-active-color);
      text-decoration: none;
    }
    .tag-count {
      font-size: 0.7rem;
      opacity: 0.65;
    }

    .recent-list {
      list-style: none;
      padding: 0;
    }
    .recent-list li {
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--main-border-color);
      font-size: 0.85rem;
      line-height: 1.4;
    }
    .recent-list li:first-child { padding-top: 0; }
    .recent-list li:last-child { border-bottom: none; padding-bottom: 0; }
    .recent-list a {
      color: var(--text-color);
      display: block;
    }
    .recent-list a:hover {
      color: var(--link-color);
      text-decoration: none;
    }
    .recent-date {
      display: block;
      font-size: 0.72rem;
      color: var(--text-muted-color);
      margin-top: 0.2rem;
    }

    .toc-list {
      list-style: none;
      padding: 0;
      border-left: 1px solid var(--main-border-color);
    }
    .toc-list li { line-height: 1.4; }
    .toc-list a {
      display: block;
      padding: 0.35rem 0 0.35rem 1rem;
      margin-left: -1px;
      color: var(--text-muted-color);
      border-left: 2px solid transparent;
      font-size: 0.85rem;
      transition: color 0.2s, border-color 0.2s;
    }
    .toc-list a:hover {
      color: var(--link-color);
      text-decoration: none;
    }
    .toc-list .toc-h3 a {
      padding-left: 2rem;
      font-size: 0.8rem;
    }
    .toc-list a.active {
      color: var(--link-color);
      border-left-color: var(--link-color);
    }

    /* ========== Home: post list cards ========== */

    #post-list { display: flex; flex-direction: column; gap: 1.25rem; }

    .card-wrapper {
      display: block;
      border-radius: var(--radius-lg);
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
      transition: background 0.35s;
    }
    .card-wrapper:hover {
      text-decoration: none;
      background: var(--card-hover-bg);
    }

    .card-body {
      padding: 1.5rem 1.75rem 1.25rem;
    }
    @media (max-width: 600px) {
      .card-body { padding: 1rem 1.25rem; }
    }

    .card-title {
      font-family: var(--font-family-heading);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--heading-color);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .card-text {
      color: var(--text-muted-color);
      font-size: 0.95rem;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0.85rem;
    }

    .post-meta {
      color: var(--text-muted-color);
      font-size: 0.85rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 1.5rem;
    }
    .post-meta .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .post-meta svg.icon { width: 0.85rem; height: 0.85rem; }

    /* ========== Post page ========== */

    .post-header { margin-bottom: 2rem; }
    .post-header h1 {
      font-size: clamp(1.7rem, 4vw, 2.25rem);
      font-weight: 900;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin-bottom: 0.8rem;
      color: var(--heading-color);
    }
    .post-header .post-meta { margin-top: 0.5rem; }

    /* ========== Article body ========== */

    .content h1, .content h2, .content h3, .content h4, .content h5 {
      color: var(--heading-color);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      line-height: 1.3;
    }
    .content h1 { font-size: 1.9rem; font-weight: 900; }
    .content h2 {
      font-size: 1.5rem;
      font-weight: 700;
      padding-bottom: 0.3rem;
      border-bottom: 1px solid var(--main-border-color);
    }
    .content h3 { font-size: 1.25rem; font-weight: 700; }
    .content h4 { font-size: 1.1rem; font-weight: 700; }

    .content p { margin-bottom: 1rem; }

    .content ul, .content ol {
      margin-bottom: 1rem;
      padding-left: 1.75rem;
    }
    .content li { margin-bottom: 0.25rem; }
    .content li::marker { color: var(--text-muted-color); }

    .content blockquote {
      border-left: 3px solid var(--blockquote-border-color);
      padding: 0.2rem 1rem;
      margin: 1.5rem 0;
      color: var(--blockquote-text-color);
    }
    .content blockquote p:last-child { margin-bottom: 0; }

    .content strong { color: var(--text-muted-highlight-color); font-weight: 700; }

    .content img {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto 0.4rem;
      border-radius: var(--radius-lg);
    }
    .content img + em {
      display: block;
      text-align: center;
      color: var(--text-muted-color);
      font-size: 0.85rem;
      font-style: italic;
      margin-bottom: 1.5rem;
    }

    .content code {
      background: var(--inline-code-bg);
      color: var(--code-color);
      padding: 0.15em 0.4em;
      border-radius: 4px;
      font-family: 'Source Code Pro', 'SF Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85em;
    }
    .content pre {
      background: var(--highlight-bg-color);
      border: 1px solid var(--language-border-color);
      padding: 1rem 1.2rem;
      border-radius: var(--radius-lg);
      overflow-x: auto;
      margin: 1.5rem 0;
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--code-color);
    }
    .content pre code {
      background: none;
      padding: 0;
      font-size: inherit;
      color: inherit;
    }

    .content hr {
      border: none;
      border-top: 1px solid var(--main-border-color);
      margin: 2.5rem 0;
    }

    .content a {
      color: var(--link-color);
      text-decoration: underline;
      text-decoration-color: var(--link-underline-color);
      text-underline-offset: 2px;
    }
    .content a:hover { text-decoration-color: var(--link-color); }

    /* ========== Post footer nav ========== */

    .post-footer-nav {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--main-border-color);
      font-size: 0.9rem;
    }

    /* ========== Home header ========== */

    .home-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
    }
    .home-header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--heading-color);
      letter-spacing: 0.01em;
    }
  </style>
</head>
