  <header id="topbar-wrapper">
    <button id="sidebar-trigger" type="button" aria-label="Ouvrir le menu">
      <svg class="icon"><use href="#i-bars"/></svg>
    </button>
    <span id="topbar-title">{{ site.title }}</span>
  </header>

  <div id="mask"></div>

  <aside id="sidebar" aria-label="Sidebar">
    <div class="profile-wrapper">
      <a href="/" id="avatar">
        <img src="/assets/img/avatar.jpeg" alt="{{ site.author }}">
      </a>
      <h1 class="site-title"><a href="/">{{ site.title }}</a></h1>
      <p class="site-subtitle">{{ site.tagline }}</p>
    </div>

    <ul class="sidebar-nav">
      <li{% if page.url == "/" %} class="active"{% endif %}>
        <a href="/"><svg class="icon"><use href="#i-home"/></svg>Accueil</a>
      </li>
      <li{% if page.url == "/about/" %} class="active"{% endif %}>
        <a href="/about/"><svg class="icon"><use href="#i-user"/></svg>À propos</a>
      </li>
    </ul>

    <div class="sidebar-bottom">
      <a href="https://github.com/{{ site.github }}" aria-label="GitHub">
        <svg class="icon"><use href="#i-github"/></svg>
      </a>
      <a href="mailto:{{ site.email }}" aria-label="Contact">
        <svg class="icon"><use href="#i-envelope"/></svg>
      </a>
      <p class="copyright">&copy; {{ currentYear }} {{ site.author }}</p>
    </div>
  </aside>

  <div id="main-wrapper">
    <div class="page">
      <main>
        {{ content | safe }}
      </main>

      <aside id="panel-wrapper" aria-label="Panel">
        {% if collections.tagList and collections.tagList.length %}
        <section class="panel-box">
          <h3 class="panel-heading">
            <svg class="icon"><use href="#i-hashtag"/></svg>Tags populaires
          </h3>
          <ul class="tag-list">
            {% for tag in collections.tagList %}
            <li><span class="tag-pill">{{ tag.name }}<span class="tag-count">{{ tag.count }}</span></span></li>
            {% endfor %}
          </ul>
        </section>
        {% endif %}

        {% if collections.posts.length %}
        <section class="panel-box">
          <h3 class="panel-heading">
            <svg class="icon"><use href="#i-clock"/></svg>Récemment publié
          </h3>
          <ul class="recent-list">
            {% for post in collections.posts %}
              {% if loop.index0 < 5 %}
              <li>
                <a href="{{ post.url }}">
                  {{ post.data.title }}
                  <span class="recent-date">{{ post.date | dateFr }}</span>
                </a>
              </li>
              {% endif %}
            {% endfor %}
          </ul>
        </section>
        {% endif %}
      </aside>
    </div>
  </div>

  <script>
    (function () {
      var html = document.documentElement;
      var trigger = document.getElementById('sidebar-trigger');
      var mask = document.getElementById('mask');
      function toggle() {
        if (html.hasAttribute('sidebar-display')) html.removeAttribute('sidebar-display');
        else html.setAttribute('sidebar-display', '');
      }
      if (trigger) trigger.addEventListener('click', toggle);
      if (mask) mask.addEventListener('click', toggle);
    })();

    (function () {
      var panel = document.getElementById('panel-wrapper');
      if (!panel) return;
      var content = document.querySelector('article .post-header + .content, article .content');
      if (!content || !document.querySelector('article .post-header')) return;
      var headings = content.querySelectorAll('h2, h3');
      if (!headings.length) return;

      var box = document.createElement('section');
      box.className = 'panel-box toc-box';
      box.innerHTML =
        '<h3 class="panel-heading">' +
        '<svg class="icon"><use href="#i-list"/></svg>Contenu</h3>';
      var ul = document.createElement('ul');
      ul.className = 'toc-list';

      var links = [];
      headings.forEach(function (h, i) {
        if (!h.id) {
          h.id = 'h-' + i + '-' + (h.textContent || '')
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .trim()
            .replace(/\s+/g, '-');
        }
        var li = document.createElement('li');
        li.className = 'toc-' + h.tagName.toLowerCase();
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.appendChild(a);
        ul.appendChild(li);
        links.push({ a: a, h: h });
      });

      box.appendChild(ul);
      panel.insertBefore(box, panel.firstChild);

      var ticking = false;
      function updateActive() {
        ticking = false;
        var offset = 120;
        var current = links[0];
        for (var i = 0; i < links.length; i++) {
          if (links[i].h.getBoundingClientRect().top - offset <= 0) current = links[i];
          else break;
        }
        links.forEach(function (l) {
          l.a.classList.toggle('active', l === current);
        });
      }
      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(updateActive);
          ticking = true;
        }
      }, { passive: true });
      updateActive();
    })();
  </script>
</body>
</html>
