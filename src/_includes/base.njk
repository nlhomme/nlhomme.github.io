<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png">
  <link rel="shortcut icon" href="/assets/img/favicons/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png">
  <link rel="mask-icon" href="/assets/img/favicons/safari-pinned-tab.svg" color="#0071e3">

  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <style>
    :root {
      --bg: #ffffff;
      --bg-alt: #f5f5f7;
      --fg: #1d1d1f;
      --fg-muted: #6e6e73;
      --accent: #0071e3;
      --accent-hover: #0062c4;
      --card-bg: #ffffff;
      --card-border: #e5e5e7;
      --code-bg: #f0f0f2;
      --footer-bg: #f5f5f7;
      --blockquote-border: #d2d2d7;
    }

    [data-theme="dark"] {
      --bg: #000000;
      --bg-alt: #1c1c1e;
      --fg: #f5f5f7;
      --fg-muted: #98989d;
      --accent: #2997ff;
      --accent-hover: #40a5ff;
      --card-bg: #1c1c1e;
      --card-border: #38383a;
      --code-bg: #2c2c2e;
      --footer-bg: #1c1c1e;
      --blockquote-border: #38383a;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #000000;
        --bg-alt: #1c1c1e;
        --fg: #f5f5f7;
        --fg-muted: #98989d;
        --accent: #2997ff;
        --accent-hover: #40a5ff;
        --card-bg: #1c1c1e;
        --card-border: #38383a;
        --code-bg: #2c2c2e;
        --footer-bg: #1c1c1e;
        --blockquote-border: #38383a;
      }
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--fg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg);
      border-bottom: 1px solid var(--card-border);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .nav-inner {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-brand {
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--fg);
      text-decoration: none;
    }
    .nav-brand:hover { text-decoration: none; }

    .nav-right { display: flex; align-items: center; gap: 0.5rem; }

    .nav-link {
      color: var(--fg-muted);
      font-size: 0.9rem;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-link:hover { color: var(--fg); background: var(--bg-alt); text-decoration: none; }

    .theme-toggle {
      background: none;
      border: none;
      color: var(--fg-muted);
      cursor: pointer;
      font-size: 1.1rem;
      line-height: 1;
      padding: 0.35rem 0.55rem;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
      font-family: inherit;
    }
    .theme-toggle:hover { color: var(--fg); background: var(--bg-alt); }

    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
    }

    /* Home */
    .home-header { margin-bottom: 3rem; text-align: center; }
    .home-header h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }
    .home-header .tagline {
      font-size: clamp(1rem, 2vw, 1.15rem);
      color: var(--fg-muted);
      font-weight: 400;
    }

    .post-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .post-list li {
      border-bottom: 1px solid var(--card-border);
      padding: 1.25rem 0;
    }
    .post-list li:last-child { border-bottom: none; }
    .post-list time {
      display: block;
      font-size: 0.8rem;
      color: var(--fg-muted);
      font-variant-numeric: tabular-nums;
      margin-bottom: 0.3rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .post-list h2 {
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.3;
    }
    .post-list h2 a { color: var(--fg); }
    .post-list h2 a:hover { color: var(--accent); text-decoration: none; }

    /* Post */
    .post-header { margin-bottom: 2.5rem; }
    .post-header h1 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 0.6rem;
    }
    .post-meta {
      font-size: 0.85rem;
      color: var(--fg-muted);
      font-variant-numeric: tabular-nums;
    }
    .post-meta .tag {
      display: inline-block;
      padding: 0.1rem 0.55rem;
      background: var(--code-bg);
      border-radius: 100px;
      font-size: 0.75rem;
      margin-left: 0.4rem;
    }

    /* Article body */
    .post-content h2, .page-content h2 {
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin-top: 2.5rem;
      margin-bottom: 0.8rem;
    }
    .post-content h3, .page-content h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 0.6rem;
    }
    .post-content h4, .page-content h4 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }
    .post-content p, .page-content p { margin-bottom: 1.2rem; }
    .post-content ul, .post-content ol,
    .page-content ul, .page-content ol {
      margin-bottom: 1.2rem;
      padding-left: 1.5rem;
    }
    .post-content li, .page-content li { margin-bottom: 0.3rem; }

    .post-content blockquote, .page-content blockquote {
      border-left: 3px solid var(--blockquote-border);
      padding: 0.2rem 1rem;
      margin: 1.5rem 0;
      color: var(--fg-muted);
      font-style: italic;
    }
    .post-content blockquote p:last-child,
    .page-content blockquote p:last-child { margin-bottom: 0; }

    .post-content img, .page-content img {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto 0.4rem;
      border-radius: 12px;
      border: 1px solid var(--card-border);
    }
    .post-content img + em, .page-content img + em {
      display: block;
      text-align: center;
      color: var(--fg-muted);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .post-content code, .page-content code {
      background: var(--code-bg);
      padding: 0.15em 0.4em;
      border-radius: 5px;
      font-family: "SF Mono", SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.88em;
    }
    .post-content pre, .page-content pre {
      background: var(--code-bg);
      padding: 1rem 1.2rem;
      border-radius: 10px;
      overflow-x: auto;
      margin: 1.5rem 0;
      font-size: 0.85rem;
      line-height: 1.5;
    }
    .post-content pre code, .page-content pre code {
      background: none;
      padding: 0;
      font-size: inherit;
    }

    .post-content hr, .page-content hr {
      border: none;
      border-top: 1px solid var(--card-border);
      margin: 2.5rem 0;
    }

    .post-footer-nav {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--card-border);
      font-size: 0.9rem;
    }

    footer {
      background: var(--footer-bg);
      border-top: 1px solid var(--card-border);
      padding: 2rem 1.5rem;
      text-align: center;
    }
    footer p { font-size: 0.85rem; color: var(--fg-muted); margin-bottom: 0.4rem; }
    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-bottom: 0.8rem;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-brand">{{ site.title }}</a>
      <div class="nav-right">
        <a href="/about/" class="nav-link">À propos</a>
        <button class="theme-toggle" id="themeToggle" aria-label="Changer le thème">&#9790;</button>
      </div>
    </div>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-links">
      <a href="https://github.com/{{ site.github }}">GitHub</a>
      <a href="mailto:{{ site.email }}">Contact</a>
    </div>
    <p>&copy; {{ currentYear }} {{ site.author }}</p>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById('themeToggle');
      var html = document.documentElement;

      function stored() { return localStorage.getItem('nl-theme') || 'system'; }
      function isDark() {
        var t = stored();
        if (t === 'dark') return true;
        if (t === 'light') return false;
        return window.matchMedia('(prefers-color-scheme: dark)').matches;
      }
      function apply(t) {
        if (t === 'system') html.removeAttribute('data-theme');
        else html.setAttribute('data-theme', t);
      }
      function icon() { btn.textContent = isDark() ? '\u2600' : '\u263E'; }

      apply(stored());
      icon();

      btn.addEventListener('click', function () {
        var next = isDark() ? 'light' : 'dark';
        localStorage.setItem('nl-theme', next);
        apply(next);
        icon();
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', icon);
    })();
  </script>
</body>
</html>
