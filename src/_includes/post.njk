---
layout: base.njk
---
<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <span class="meta-item">
        <svg class="icon"><use href="#i-calendar"/></svg>
        <time datetime="{{ page.date | isoDate }}">{{ page.date | dateFr }}</time>
      </span>
      {% if categories and categories.length %}
      <span class="meta-item">
        <svg class="icon"><use href="#i-folder"/></svg>
        <span>{{ categories | join(", ") }}</span>
      </span>
      {% endif %}
    </div>
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
  <nav class="post-footer-nav">
    <a href="/">← Retour aux articles</a>
  </nav>
</article>
